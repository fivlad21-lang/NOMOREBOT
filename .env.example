# Site (after DNS: https://nomorelab.wtf)
NEXT_PUBLIC_SITE_URL=https://nomorelab.wtf

# FX USD→UAH for WayForPay amounts (optional; default in src/data/pricing.ts)
# NEXT_PUBLIC_FX_USD_UAH=44.81

# Analytics (E8) — leave empty to disable pixel scripts
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# WayForPay — NEVER commit real secret keys.
# Test (wiki): merchantAccount=test_merch_n1  secret=flk3409refn54t54t*FNJRET
# Live: your cabinet merchant + secret. Domain must match cabinet.
WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_SECRET_KEY=flk3409refn54t54t*FNJRET
WAYFORPAY_DOMAIN=nomorebot.vercel.app
WAYFORPAY_SERVICE_URL=https://nomorebot.vercel.app/api/pay/webhook

# Orders persistence (E3) — Upstash Redis or Vercel KV
# Without these, orders use in-memory store (ok for local, risky on Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# or: KV_REST_API_URL=  KV_REST_API_TOKEN=
